[Unit]
Description=Studiolo backup worker
After=network-online.target
ConditionPathExists=/etc/studiolo/backup-worker.json

[Service]
Type=simple
ExecStart=/usr/local/bin/studiolo-backup-worker
User=studiolo-backup
Group=studiolo-backup-readers
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=yes
MemoryMax=512M
LimitCORE=0
StateDirectory=studiolo-backup-worker
ReadOnlyPaths=/etc/studiolo/backup-worker.json
Restart=on-failure
RestartSec=5
StartLimitIntervalSec=60
StartLimitBurst=3

[Install]
WantedBy=multi-user.target
