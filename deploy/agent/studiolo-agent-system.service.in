# Studiolo M3 系统服务（进程仍以 maxsong 运行）；@RELEASE@ 必须替换为已校验的发布目录名。
# 只监听 127.0.0.1:4400；公网入口由专用 Tunnel 的独立主机名转发到此回环端口，门禁在应用内（bearer）。
[Unit]
Description=Studiolo M3 agent supply (MCP, loopback 4400)
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
# 系统管理器建立只读挂载隔离，保留宿主 UID；用户管理器会将宿主 root 映射为 overflow UID。
Type=simple
User=maxsong
Group=maxsong
PrivateUsers=no
WorkingDirectory=/home/maxsong/.local/share/studiolo-agent-releases/@RELEASE@
# 白名单完整批次由 scripts/sync-agent-vault.sh 推送；先完成首批同步再启用本单元。
# 私有库/账本沿用既有目录；副本每次读取完整验证，超过 300 秒不再声称新鲜。
ExecStart=/home/maxsong/.local/share/studiolo-agent-releases/@RELEASE@/bin/studiolo-agent serve --replica-root /home/maxsong/.local/share/studiolo-agent-replica --replica-max-age-secs 300 --allow 项目/Studiolo --allow _规则 --data /home/maxsong/.local/share/studiolo-agent --port 4400
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# 唯一可写路径：私有库 agent.sqlite3 与审计账本；发布目录与库副本保持只读。
ReadWritePaths=/home/maxsong/.local/share/studiolo-agent
PrivateTmp=yes
# 此选项会拦截 openat2（只读 Broker 依赖它）；以只读文件系统和 NoNewPrivileges 维持写入/提权边界。
RestrictSUIDSGID=no
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET
SystemCallArchitectures=native
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
