# Studiolo M3 供给面运行包（studiolo-agent）；@RELEASE@ 必须替换为已校验的发布目录名。
# 只监听 127.0.0.1:4400；公网入口由专用 Tunnel 的独立主机名转发到此回环端口，门禁在应用内（bearer）。
[Unit]
Description=Studiolo M3 agent supply (MCP, loopback 4400)
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/.local/share/studiolo-agent-releases/@RELEASE@
# 仅供历史直接副本模式/回滚使用；托管副本须用 studiolo-agent-system.service.in。
# 用户管理器的挂载隔离会折叠宿主 UID，无法满足托管副本的祖先属主检查。
ExecStart=%h/.local/share/studiolo-agent-releases/@RELEASE@/bin/studiolo-agent serve --vault %h/.local/share/studiolo-agent-vault --allow 项目/Studiolo --allow 项目/Tillerwright --allow _规则 --data %h/.local/share/studiolo-agent --port 4400
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20
UMask=0077
# T-050/T-059/T-066：秘密驻留面加固在 Linux 用 mlockall 把持有明文秘密的页锁在内存，
# 防止被换出到交换区。systemd 默认 LimitMEMLOCK 常为 8M，不足时 harden() **失败关闭
# 并终止进程**（这是正确行为，不得改成尽力而为），服务将无法启动。
# studiolo-agent 持有类型 token 与每次请求的 bearer 明文，加固接入后本项即为必需；
# 现在先行加上，使加固落地时不需要再动部署单元。见 docs/m2/secret-residency.md。
LimitMEMLOCK=infinity
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
# 唯一可写路径：私有库 agent.sqlite3 与审计账本；发布目录与库副本保持只读。
ReadWritePaths=%h/.local/share/studiolo-agent
PrivateTmp=yes
# 此选项会拦截 openat2（只读 Broker 依赖它）；以只读文件系统和 NoNewPrivileges 维持写入/提权边界。
RestrictSUIDSGID=no
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET
SystemCallArchitectures=native
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=default.target
